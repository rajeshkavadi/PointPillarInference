<launch>
  <!-- CPU-only PointPillars + Livox bag playback + web (three.js) viewer.
       RViz is optional and off by default: the browser page is the viewer. -->

  <arg name="bag" default="$(find livox_detection)/data/demo1.bag"/>
  <arg name="play_bag" default="true"/>
  <!-- One CPU pass takes ~4-5 s on the target 4-core machine.  0.1x playback
       still produces ~1 Hz LiDAR input; increase only if your CPU is faster. -->
  <arg name="play_rate" default="0.1"/>
  <arg name="start" default="0"/>

  <!-- Viewers: the web viewer is the default replacement for RViz. -->
  <arg name="launch_web" default="true"/>
  <arg name="web_port" default="8080"/>
  <arg name="launch_rviz" default="false"/>

  <arg name="cfg_file" default="$(find livox_detection)/configs/pointpillars.yaml"/>
  <arg name="ckpt" default="$(find livox_detection)/checkpoints/pointpillars_checkpoint.pth"/>
  <arg name="lidar_topic" default="/livox/lidar"/>
  <arg name="points_topic" default="/pointcloud"/>
  <arg name="box_topic" default="/detect_box3d"/>
  <arg name="text_topic" default="/text_det"/>
  <arg name="json_topic" default="/detect_json"/>
  <arg name="frame_id" default=""/>
  <arg name="intensity_mode" default="zero"/>
  <arg name="z_offset" default="0.0"/>
  <arg name="queue_size" default="1"/>
  <arg name="log_every" default="1"/>

  <node pkg="livox_detection" type="pointpillars_ros_cpu.py"
        name="pointpillars_cpu" output="screen">
    <param name="cfg_file" value="$(arg cfg_file)"/>
    <param name="ckpt" value="$(arg ckpt)"/>
    <param name="lidar_topic" value="$(arg lidar_topic)"/>
    <param name="points_topic" value="$(arg points_topic)"/>
    <param name="box_topic" value="$(arg box_topic)"/>
    <param name="text_topic" value="$(arg text_topic)"/>
    <param name="json_topic" value="$(arg json_topic)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="intensity_mode" value="$(arg intensity_mode)"/>
    <param name="z_offset" value="$(arg z_offset)"/>
    <param name="queue_size" value="$(arg queue_size)"/>
    <param name="log_every" value="$(arg log_every)"/>
  </node>

  <!-- three.js viewer on http://127.0.0.1:$(arg web_port) -->
  <node if="$(arg launch_web)" pkg="livox_detection" type="pointpillars_web_view.py"
        name="pointpillars_web_view" output="screen"
        args="--ros --port $(arg web_port) --points-topic $(arg points_topic) --json-topic $(arg json_topic)"/>

  <node if="$(arg play_bag)" pkg="rosbag" type="play" name="rosbag_play"
        args="--clock --rate $(arg play_rate) --start $(arg start) $(arg bag)"
        output="screen"/>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find livox_detection)/rviz/pointpillars_cpu.rviz"
        output="screen"/>
</launch>
